#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:13
msgid "12 MiB memory, 3 iterations, 1 lane"
msgstr "12 MiB Speicher, 3 Durchläufe, 1 Lane"

#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:12
msgid "19 MiB memory, 2 iterations, 1 lane"
msgstr "19 MiB Speicher, 2 Durchläufe, 1 Lane"

#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:11
msgid "46 MiB memory, 1 iteration, 1 lane"
msgstr "46 MiB Speicher, 1 Durchlauf, 1 Lane"

#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:10
msgid "64 MiB memory, 3 iterations, 4 lanes (recommended)"
msgstr "64 MiB Speicher, 3 Durchläufe, 4 Lanes (empfohlen)"

#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:15
msgid "7 MiB memory, 5 iterations, 1 lane"
msgstr "7 MiB Speicher, 5 Durchläufe, 1 Lane"

#: interaktiv/passwordpolicy/vocabularies/argon2_profiles.py:14
msgid "9 MiB memory, 4 iterations, 1 lane"
msgstr "9 MiB Speicher, 4 Durchläufe, 1 Lane"

#: interaktiv/passwordpolicy/profiles.zcml:14
msgid "Configurable password policy and Argon2id password hashing."
msgstr "Konfigurierbare Passwortrichtlinie und Argon2id-Passwort-Hashing."

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:44
msgid "Every character that is neither a letter nor a number counts as special character, e.g. spaces, punctuation or symbols like €."
msgstr "Jedes Zeichen, das weder Buchstabe noch Zahl ist, zählt als Sonderzeichen, z. B. Leerzeichen, Satzzeichen oder Symbole wie €."

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:54
msgid "If a password does not meet the policy above, the login is refused and the user has to set a new password first. Only applies to logins through the login form, not to HTTP Basic authentication (e.g. technical users)."
msgstr "Erfüllt ein Passwort die obige Richtlinie nicht, wird die Anmeldung abgelehnt und die Person muss zuerst ein neues Passwort setzen. Gilt nur für Anmeldungen über das Anmeldeformular, nicht für HTTP-Basic-Authentifizierung (z. B. technische Benutzer)."

#: interaktiv/passwordpolicy/profiles.zcml:14
msgid "Interaktiv Passwordpolicy: Install"
msgstr "Interaktiv Passwordpolicy: Installieren"

#: interaktiv/passwordpolicy/profiles.zcml:23
msgid "Interaktiv Passwordpolicy: Uninstall"
msgstr "Interaktiv Passwordpolicy: Deinstallieren"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:66
msgid "Memory and time used to hash a password. All profiles are equally strong; less memory is compensated by more iterations. Choose a lower memory profile if the server cannot afford the memory per login. Only applies to newly set passwords."
msgstr "Speicher und Zeit, die zum Hashen eines Passworts verwendet werden. Alle Profile sind gleich stark; weniger Speicher wird durch mehr Durchläufe ausgeglichen. Wählen Sie ein Profil mit weniger Speicher, wenn der Server den Speicher pro Anmeldung nicht aufbringen kann. Gilt nur für neu gesetzte Passwörter."

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:17
msgid "Minimum password length"
msgstr "Minimale Passwortlänge"

#: interaktiv/passwordpolicy/profiles/default/controlpanel.xml
msgid "Password Policy"
msgstr "Passwortrichtlinie"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:81
msgid "Password Policy Settings"
msgstr "Einstellungen der Passwortrichtlinie"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:65
msgid "Password hashing cost (Argon2id)"
msgstr "Passwort-Hashing-Aufwand (Argon2id)"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:25
msgid "Require a lower case letter"
msgstr "Kleinbuchstaben erforderlich"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:37
msgid "Require a number"
msgstr "Zahl erforderlich"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:53
msgid "Require a password change at login"
msgstr "Passwortänderung bei der Anmeldung erzwingen"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:43
msgid "Require a special character"
msgstr "Sonderzeichen erforderlich"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:31
msgid "Require an upper case letter"
msgstr "Großbuchstaben erforderlich"

#: interaktiv/passwordpolicy/controlpanels/passwordpolicy_settings.py:18
msgid "The minimum number of characters a password must contain."
msgstr "Die minimale Anzahl an Zeichen, die ein Passwort enthalten muss."

#: interaktiv/passwordpolicy/profiles.zcml:23
msgid "Uninstall Interaktiv Passwordpolicy setup."
msgstr "Deinstalliert Interaktiv Passwordpolicy."

#: interaktiv/passwordpolicy/password_change.py:15
msgid "Your password does not meet the current password policy. Please set a new password."
msgstr "Ihr Passwort erfüllt die aktuelle Passwortrichtlinie nicht. Bitte setzen Sie ein neues Passwort."

#: interaktiv/passwordpolicy/password_change.py:20
msgid "Your password does not meet the current password policy. We have sent you an email with a link to set a new password."
msgstr "Ihr Passwort erfüllt die aktuelle Passwortrichtlinie nicht. Wir haben Ihnen eine E-Mail mit einem Link zum Setzen eines neuen Passworts gesendet."

#: interaktiv/passwordpolicy/plugins/passwordpolicy.py:59
msgid "Your password must contain at least ${min_chars} characters."
msgstr "Ihr Passwort muss mindestens ${min_chars} Zeichen haben."

#: interaktiv/passwordpolicy/plugins/passwordpolicy.py:38
msgid "Your password must contain at least one lower case letter."
msgstr "Ihr Passwort muss mindestens einen Kleinbuchstaben enthalten."

#: interaktiv/passwordpolicy/plugins/passwordpolicy.py:48
msgid "Your password must contain at least one number."
msgstr "Ihr Passwort muss mindestens eine Zahl enthalten."

#: interaktiv/passwordpolicy/plugins/passwordpolicy.py:53
msgid "Your password must contain at least one special character."
msgstr "Ihr Passwort muss mindestens ein Sonderzeichen enthalten."

#: interaktiv/passwordpolicy/plugins/passwordpolicy.py:43
msgid "Your password must contain at least one upper case letter."
msgstr "Ihr Passwort muss mindestens einen Großbuchstaben enthalten."
